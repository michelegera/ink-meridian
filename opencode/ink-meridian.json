{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "inkBg": "#101623",
    "inkPanel": "#1A2233",
    "inkSelected": "#26365A",
    "inkText": "#CCD6EA",
    "inkTextBright": "#E6ECF7",
    "inkTextMuted": "#AAB8D0",
    "inkTextDim": "#58657F",
    "inkAccent": "#83A8F2",
    "inkBlue": "#6F96E8",
    "inkBlueBright": "#8DB0F2",
    "inkCyan": "#67B7CF",
    "inkCyanBright": "#87CEE2",
    "inkGreen": "#7CBF8E",
    "inkGreenBright": "#9DD4A7",
    "inkYellow": "#D9B06E",
    "inkYellowBright": "#E9C78C",
    "inkRed": "#DE6E7C",
    "inkRedBright": "#EC8B97",
    "inkMagenta": "#A687E0",
    "inkMagentaBright": "#BDA3EC",
    "inkTintGreen": "#283B3B",
    "inkTintRed": "#3D2937",
    "inkTintBlue": "#25324E",
    "inkTintYellow": "#3C3834"
  },
  "theme": {
    "primary": { "dark": "inkBlueBright", "light": "inkBlue" },
    "secondary": { "dark": "inkMagentaBright", "light": "inkMagenta" },
    "accent": { "dark": "inkAccent", "light": "inkCyan" },
    "error": { "dark": "inkRedBright", "light": "inkRed" },
    "warning": { "dark": "inkYellowBright", "light": "inkYellow" },
    "success": { "dark": "inkGreenBright", "light": "inkGreen" },
    "info": { "dark": "inkCyanBright", "light": "inkBlue" },
    "text": { "dark": "inkText", "light": "inkBg" },
    "textMuted": { "dark": "inkTextDim", "light": "inkTextDim" },
    "background": { "dark": "inkBg", "light": "inkTextBright" },
    "backgroundPanel": { "dark": "inkPanel", "light": "inkText" },
    "backgroundElement": { "dark": "inkPanel", "light": "inkText" },
    "border": { "dark": "inkSelected", "light": "inkTextMuted" },
    "borderActive": { "dark": "inkAccent", "light": "inkBlue" },
    "borderSubtle": { "dark": "inkPanel", "light": "inkText" },
    "diffAdded": { "dark": "inkGreenBright", "light": "inkGreen" },
    "diffRemoved": { "dark": "inkRedBright", "light": "inkRed" },
    "diffContext": { "dark": "inkTextDim", "light": "inkTextDim" },
    "diffHunkHeader": { "dark": "inkBlueBright", "light": "inkBlue" },
    "diffHighlightAdded": { "dark": "inkTintGreen", "light": "inkTextBright" },
    "diffHighlightRemoved": { "dark": "inkTintRed", "light": "inkTextBright" },
    "diffAddedBg": { "dark": "inkTintGreen", "light": "inkTextBright" },
    "diffRemovedBg": { "dark": "inkTintRed", "light": "inkTextBright" },
    "diffContextBg": { "dark": "inkBg", "light": "inkText" },
    "diffLineNumber": { "dark": "inkTextDim", "light": "inkTextMuted" },
    "diffAddedLineNumberBg": { "dark": "inkTintGreen", "light": "inkTextBright" },
    "diffRemovedLineNumberBg": { "dark": "inkTintRed", "light": "inkTextBright" },
    "markdownText": { "dark": "inkText", "light": "inkBg" },
    "markdownHeading": { "dark": "inkBlueBright", "light": "inkBlue" },
    "markdownLink": { "dark": "inkMagentaBright", "light": "inkMagenta" },
    "markdownLinkText": { "dark": "inkCyanBright", "light": "inkCyan" },
    "markdownCode": { "dark": "inkGreenBright", "light": "inkGreen" },
    "markdownBlockQuote": { "dark": "inkTextDim", "light": "inkTextDim" },
    "markdownEmph": { "dark": "inkYellowBright", "light": "inkYellow" },
    "markdownStrong": { "dark": "inkTextBright", "light": "inkPanel" },
    "markdownHorizontalRule": { "dark": "inkSelected", "light": "inkTextMuted" },
    "markdownListItem": { "dark": "inkBlueBright", "light": "inkBlue" },
    "markdownListEnumeration": { "dark": "inkCyanBright", "light": "inkCyan" },
    "markdownImage": { "dark": "inkMagentaBright", "light": "inkMagenta" },
    "markdownImageText": { "dark": "inkCyanBright", "light": "inkCyan" },
    "markdownCodeBlock": { "dark": "inkText", "light": "inkBg" },
    "syntaxComment": { "dark": "inkTextDim", "light": "inkTextDim" },
    "syntaxKeyword": { "dark": "inkMagentaBright", "light": "inkMagenta" },
    "syntaxFunction": { "dark": "inkBlueBright", "light": "inkBlue" },
    "syntaxVariable": { "dark": "inkText", "light": "inkBg" },
    "syntaxString": { "dark": "inkGreenBright", "light": "inkGreen" },
    "syntaxNumber": { "dark": "inkYellowBright", "light": "inkYellow" },
    "syntaxType": { "dark": "inkCyanBright", "light": "inkCyan" },
    "syntaxOperator": { "dark": "inkCyan", "light": "inkBlue" },
    "syntaxPunctuation": { "dark": "inkTextMuted", "light": "inkTextDim" }
  }
}
